# Frontend environment variables (Vite). Vars MUST be prefixed VITE_ to be
# exposed to the browser bundle.

VITE_API_BASE_URL=http://localhost:8081
VITE_SUPABASE_URL=https://aagdtgsmjpmiqtdbdquj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_W71WGneUji2Z2iQmL141AA_5PrrbrcR

# Cross-app session sharing. Set to a parent domain (e.g. .samford.uk) to
# store the Supabase session in a cookie scoped to that domain so sibling apps
# share the session. Leave unset to keep signin per-app (localStorage).
VITE_AUTH_COOKIE_DOMAIN=.samford.uk
